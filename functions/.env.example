# Copy to functions/.env (gitignored) then: firebase deploy --only functions
# Same .p8 as EAS / Apple Developer → Keys.
# Put the full PEM on one line using \n for newlines.
# Debug / Expo dev-client devices use sandbox. TestFlight and App Store use production.
# The function tries both; this only sets which one is first.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRODUCTION=false
APNS_KEY=
